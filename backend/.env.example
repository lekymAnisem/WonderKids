# ---- Server ----
PORT=4000
NODE_ENV=development

# ---- Database (Postgres / Neon) ----
# Neon requires ?sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@HOST-POOLER/DB?sslmode=require
# Direct (non-pooled) connection used by Prisma migrations
DIRECT_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
# Optional isolated schema used by the integration test suite
TEST_DATABASE_SCHEMA=wonderkids_test

# ---- Auth ----
JWT_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=12
AUTH_COOKIE_SECURE=false

# ---- CORS ----
CORS_ORIGIN=http://localhost:3000

# ---- Storage (S3-compatible: AWS S3 / Cloudflare R2 / Supabase Storage) ----
# Use STORAGE_PROVIDER=local to store files on disk during development.
STORAGE_PROVIDER=s3
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Public base URL used to build returned object URLs (CDN or bucket public URL)
S3_PUBLIC_URL=

# ---- AI (Groq, free tier) ----
# Groq does not offer image generation, so coloring pages are generated as
# sanitized SVG line art using a free Groq text model (OpenAI-compatible API).
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_IMAGE_MODEL=openai/gpt-oss-120b
AI_RATE_LIMIT_MAX=5
