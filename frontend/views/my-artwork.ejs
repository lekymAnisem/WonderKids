<%- include('partials/head', { title: title }) %>
<body class="bg-background text-on-surface antialiased selection:bg-primary-fixed selection:text-on-primary-fixed">
<%- include('partials/navbar', { progress: progress, activeNav: activeNav }) %>

<section class="relative overflow-hidden pt-8 pb-12 md:pt-14 md:pb-20">
  <div class="absolute top-10 left-1/2 -translate-x-1/2 w-[700px] h-[300px] bg-primary-fixed/30 rounded-full blur-3xl pointer-events-none -z-10"></div>
  <div class="max-w-[1240px] mx-auto px-6">
    <div class="text-center max-w-3xl mx-auto flex flex-col items-center mb-10">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-primary-fixed/50 text-primary font-label-sm mb-5 shadow-sm">
        <span class="material-symbols-outlined text-sm fill-icon" style="font-variation-settings: 'FILL' 1;">palette</span>
        <span>My Collection</span>
      </div>
      <h1 class="text-headline-lg-mobile md:text-headline-lg font-headline-lg text-on-surface tracking-tight mb-4">
        My <span class="text-primary-container">Artwork</span>
      </h1>
      <p class="text-body-md font-body-md text-on-surface-variant max-w-2xl">
        All your saved coloring pages and drawings. Share them on the WonderKids Wall!
      </p>
    </div>

    <% if (artworks.length === 0) { %>
    <div class="text-center py-20">
      <span class="text-7xl mb-6 block">🎨</span>
      <p class="text-headline-sm font-headline-sm text-on-surface mb-3">No artwork yet!</p>
      <p class="text-body-sm font-body-sm text-on-surface-variant mb-6">Head to the Coloring Studio to create your first masterpiece.</p>
      <a href="/coloring" class="px-8 py-3 rounded-full bg-primary-container text-white font-label-lg font-bold shadow-lg inline-block">
        Start Coloring
      </a>
    </div>
    <% } else { %>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      <% artworks.forEach(function(art) { %>
      <div class="tactile-card rounded-2xl overflow-hidden border border-surface-container-highest shadow-sm group">
        <div class="relative aspect-[4/3] bg-surface-container-low overflow-hidden">
          <% if (art.imageUrl || art.imageData) { %>
          <img src="<%= art.imageUrl || art.imageData %>" alt="<%= art.title %>" class="w-full h-full object-contain group-hover:scale-105 transition-transform duration-300" loading="lazy">
          <% } else { %>
          <div class="w-full h-full flex items-center justify-center text-6xl">🎨</div>
          <% } %>
        </div>
        <div class="p-4">
          <div class="flex items-center justify-between mb-3">
            <span class="text-xs font-label-sm text-on-surface-variant"><%= new Date(art.createdAt).toLocaleDateString() %></span>
            <% if (art.sharedToWall) { %>
            <span class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-secondary-fixed text-secondary flex items-center gap-1">
              <span class="material-symbols-outlined text-[10px]">check</span> Shared
            </span>
            <% } %>
          </div>
          <div class="flex items-center gap-2">
            <% if (!art.sharedToWall) { %>
            <form method="POST" action="/wall/post" class="flex-1">
              <input type="hidden" name="content" value="Check out my artwork!">
              <input type="hidden" name="imageUrl" value="<%= art.imageUrl || '' %>">
              <input type="hidden" name="imageData" value="<%= art.imageData || '' %>">
              <input type="hidden" name="artS3Key" value="<%= art.s3Key || '' %>">
              <input type="hidden" name="artworkId" value="<%= art.id %>">
              <button type="submit" class="w-full px-4 py-2 rounded-full bg-secondary text-white text-xs font-label-sm font-bold hover:opacity-90 active:scale-95 transition-all flex items-center justify-center gap-1.5 shadow-sm">
                <span class="material-symbols-outlined text-sm">share</span> Share to Wall
              </button>
            </form>
            <% } else { %>
            <a href="/wall" class="flex-1 px-4 py-2 rounded-full bg-surface-container text-on-surface-variant text-xs font-label-sm font-bold hover:bg-surface-container-high text-center flex items-center justify-center gap-1.5">
              <span class="material-symbols-outlined text-sm">visibility</span> View on Wall
            </a>
            <% } %>
            <form method="POST" action="/api/artwork/delete" onsubmit="return confirm('Delete this artwork?')">
              <input type="hidden" name="artworkId" value="<%= art.id %>">
              <button type="submit" class="p-2 rounded-lg hover:bg-error-container/50 text-error transition-colors">
                <span class="material-symbols-outlined text-sm">delete</span>
              </button>
            </form>
          </div>
        </div>
      </div>
      <% }) %>
    </div>
    <% } %>
  </div>
</section>

<%- include('partials/parent-zone') %>
<%- include('partials/footer') %>
</body></html>
