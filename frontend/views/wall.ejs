<%- include('partials/head', { title: title }) %>
<body class="bg-background text-on-surface antialiased selection:bg-primary-fixed selection:text-on-primary-fixed">
<%- include('partials/navbar', { progress: progress, activeNav: activeNav }) %>

<section class="relative overflow-hidden pt-8 pb-8 md:pt-12">
  <div class="absolute top-10 left-1/2 -translate-x-1/2 w-[600px] h-[250px] bg-secondary-fixed/30 rounded-full blur-3xl pointer-events-none -z-10"></div>
  <div class="max-w-5xl mx-auto px-4">
    <div class="flex flex-col lg:flex-row gap-6">
      <!-- Main Feed -->
      <div class="flex-1 min-w-0">
        <div class="text-center mb-8 lg:text-left">
          <h1 class="text-headline-lg-mobile md:text-headline-lg font-headline-lg text-on-surface tracking-tight mb-2">
            WonderKids <span class="text-secondary-container">Wall</span>
          </h1>
          <p class="text-body-sm font-body-sm text-on-surface-variant">Share achievements, artwork, and celebrate together!</p>
        </div>

        <% if (typeof user !== 'undefined' && user) { %>
        <!-- Post Composer -->
        <div class="tactile-card rounded-2xl p-5 mb-6 border border-surface-container-highest shadow-sm">
          <form method="POST" action="/wall/post" id="postForm">
            <div class="flex items-start gap-3">
              <a href="/auth/profile" class="w-10 h-10 rounded-full bg-secondary-container text-on-secondary-container flex items-center justify-center font-bold text-sm shrink-0 hover:ring-2 hover:ring-secondary transition-all" title="Change avatar"><%= user.avatar %></a>
              <div class="flex-1">
                <textarea name="content" id="postContent" rows="2" placeholder="Share something amazing your child did today..."
                  class="w-full px-4 py-3 rounded-xl bg-surface-container-low border border-surface-container text-on-surface font-body-sm placeholder:text-on-surface-variant/50 focus:outline-none focus:border-secondary focus:ring-1 focus:ring-secondary/20 transition-all resize-none"></textarea>
                <input type="hidden" name="imageData" id="postImageData">
                <div id="postImagePreview" class="hidden mt-2 relative">
                  <img id="postPreviewImg" class="max-h-40 rounded-xl border border-surface-container" alt="Preview">
                  <button type="button" id="removeImage" class="absolute -top-2 -right-2 w-6 h-6 rounded-full bg-error text-white text-xs flex items-center justify-center shadow">x</button>
                </div>
                <div class="flex items-center justify-between mt-3">
                  <div class="flex items-center gap-2">
                    <label class="flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-surface-container hover:bg-surface-container-high cursor-pointer transition-colors text-xs font-label-sm text-on-surface-variant font-bold">
                      <span class="material-symbols-outlined text-sm">image</span> Photo
                      <input type="file" id="postImageInput" accept="image/png,image/jpeg,image/webp" class="hidden">
                    </label>
                    <button type="button" id="shareScoreBtn" class="flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-surface-container hover:bg-surface-container-high transition-colors text-xs font-label-sm text-on-surface-variant font-bold">
                      <span class="material-symbols-outlined text-sm">emoji_events</span> Score
                    </button>
                  </div>
                  <button type="submit" class="px-5 py-2 rounded-full bg-secondary text-white text-xs font-label-sm font-bold hover:opacity-90 active:scale-95 transition-all shadow-sm">
                    Post
                  </button>
                </div>
              </div>
            </div>
          </form>
        </div>
        <% } else { %>
        <div class="tactile-card rounded-2xl p-6 mb-6 border border-surface-container-highest text-center">
          <p class="text-body-sm font-body-sm text-on-surface-variant mb-3">Sign in to share and interact!</p>
          <a href="/auth/login" class="px-6 py-2.5 rounded-full bg-primary-container text-white font-label-sm font-bold shadow-sm inline-block">Sign In</a>
        </div>
        <% } %>

        <!-- Posts Feed -->
        <div id="postsFeed" class="flex flex-col gap-4">
          <% if (posts.length === 0) { %>
          <div class="text-center py-16">
            <span class="text-6xl mb-4 block">🌟</span>
            <p class="text-headline-sm font-headline-sm text-on-surface mb-2">No posts yet!</p>
            <p class="text-body-sm font-body-sm text-on-surface-variant">Be the first to share an achievement or artwork.</p>
          </div>
          <% } %>

          <% posts.forEach(function(post) { %>
          <div class="tactile-card rounded-2xl overflow-hidden border border-surface-container-highest shadow-sm" data-post-id="<%= post.id %>">
            <div class="flex items-center gap-3 p-4 pb-2">
              <div class="w-10 h-10 rounded-full <%= post.authorRole === 'admin' ? 'bg-tertiary-container' : 'bg-secondary-container' %> flex items-center justify-center font-bold text-sm shrink-0">
                <%= post.authorAvatar %>
              </div>
              <div class="flex-1 min-w-0">
                <div class="flex items-center gap-2 flex-wrap">
                  <span class="font-label-md font-bold text-on-surface text-sm"><%= post.authorName %></span>
                  <% if (post.authorRole === 'admin') { %>
                  <span class="text-[9px] font-bold px-1.5 py-0.5 rounded-full bg-tertiary-fixed text-tertiary">ADMIN</span>
                  <% } %>
                  <% if (post.friendship === 'friends') { %>
                  <span class="text-[9px] font-bold px-1.5 py-0.5 rounded-full bg-emerald-100 text-emerald-700">Friend</span>
                  <% } %>
                </div>
                <span class="text-[11px] text-on-surface-variant font-body-sm"><%= post.timeAgo %></span>
              </div>
              <% if (typeof user !== 'undefined' && user && post.userId !== user.id && post.friendship === 'none') { %>
              <button class="add-friend-post-btn px-3 py-1 rounded-full bg-secondary text-white text-[10px] font-bold hover:opacity-90 active:scale-95 transition-all flex items-center gap-1" data-user-id="<%= post.userId %>">
                <span class="material-symbols-outlined text-[12px]">person_add</span> Add Friend
              </button>
              <% } else if (typeof user !== 'undefined' && user && post.friendship === 'sent') { %>
              <span class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-surface-container text-on-surface-variant">Request Sent</span>
              <% } else if (typeof user !== 'undefined' && user && post.friendship === 'received') { %>
              <div class="flex gap-1">
                <button class="accept-post-btn px-2 py-1 rounded-full bg-secondary text-white text-[10px] font-bold" data-user-id="<%= post.userId %>">Accept</button>
              </div>
              <% } %>
              <% if (post.type === 'score') { %>
              <span class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-tertiary-fixed text-tertiary flex items-center gap-1">
                <span class="material-symbols-outlined text-[12px]">emoji_events</span> Score
              </span>
              <% } else if (post.type === 'artwork') { %>
              <span class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-primary-fixed text-primary flex items-center gap-1">
                <span class="material-symbols-outlined text-[12px]">palette</span> Art
              </span>
              <% } %>
            </div>

            <% if (post.content) { %>
            <div class="px-4 pb-2">
              <p class="text-body-sm font-body-sm text-on-surface leading-relaxed"><%= post.content %></p>
            </div>
            <% } %>

            <% if (post.image) { %>
            <div class="px-4 pb-2">
              <img src="<%= post.image %>" alt="Post image" class="w-full rounded-xl max-h-96 object-contain bg-surface-container-low border border-surface-container" loading="lazy">
            </div>
            <% } %>

            <% if (post.type === 'score' && post.score !== undefined) { %>
            <div class="px-4 pb-2">
              <div class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-gradient-to-r from-tertiary-fixed to-secondary-container/30 border border-tertiary-fixed-dim/30">
                <span class="text-2xl">🏆</span>
                <div>
                  <span class="text-xs font-bold text-on-surface block"><%= post.game || 'Game' %></span>
                  <span class="text-lg font-headline-md font-bold text-tertiary"><%= post.score %> pts</span>
                </div>
              </div>
            </div>
            <% } %>

            <div class="flex items-center justify-between px-4 py-2 text-[11px] text-on-surface-variant">
              <span><%= post.reactionCount > 0 ? post.reactionCount + ' reaction' + (post.reactionCount > 1 ? 's' : '') : '' %></span>
              <span><%= post.commentCount > 0 ? post.commentCount + ' comment' + (post.commentCount > 1 ? 's' : '') : '' %></span>
            </div>

            <div class="flex items-center border-t border-surface-container">
              <button class="react-btn flex-1 flex items-center justify-center gap-1.5 py-3 hover:bg-surface-container-low transition-colors text-xs font-label-sm font-bold <%= post.userHasReacted ? 'text-secondary' : 'text-on-surface-variant' %>"
                data-post-id="<%= post.id %>">
                <span class="material-symbols-outlined text-[18px] <%= post.userHasReacted ? 'fill-icon' : '' %>" style="font-variation-settings: 'FILL' <%= post.userHasReacted ? '1' : '0' %>;">favorite</span>
                <span>React</span>
                <span class="react-count"><%= post.reactionCount %></span>
              </button>
              <div class="w-px h-6 bg-surface-container"></div>
              <button class="comment-toggle-btn flex-1 flex items-center justify-center gap-1.5 py-3 hover:bg-surface-container-low transition-colors text-xs font-label-sm font-bold text-on-surface-variant"
                data-post-id="<%= post.id %>">
                <span class="material-symbols-outlined text-[18px]">chat_bubble_outline</span>
                <span>Comment</span>
                <span class="comment-count"><%= post.commentCount %></span>
              </button>
            </div>

            <div class="comments-section hidden border-t border-surface-container bg-surface-container-low/30" data-post-id="<%= post.id %>">
              <div class="comments-list p-3 flex flex-col gap-2" data-post-id="<%= post.id %>">
                <% post.comments.forEach(function(c) { %>
                <div class="flex items-start gap-2">
                  <div class="w-6 h-6 rounded-full bg-secondary-container text-on-secondary-container flex items-center justify-center text-[10px] font-bold shrink-0"><%= c.userAvatar %></div>
                  <div class="flex-1 bg-surface-container-lowest rounded-xl px-3 py-2">
                    <span class="text-[11px] font-bold text-on-surface"><%= c.userName %></span>
                    <p class="text-[12px] text-on-surface-variant"><%= c.text %></p>
                  </div>
                </div>
                <% }) %>
              </div>
              <% if (typeof user !== 'undefined' && user) { %>
              <div class="flex items-center gap-2 p-3 pt-0">
                <div class="w-7 h-7 rounded-full bg-secondary-container text-on-secondary-container flex items-center justify-center text-[10px] font-bold shrink-0"><a href="/auth/profile" title="My profile"><%= user.avatar %></a></div>
                <div class="flex-1 flex gap-2">
                  <input type="text" class="comment-input flex-1 px-3 py-2 rounded-full bg-surface-container-lowest border border-surface-container text-[12px] font-body-sm text-on-surface placeholder:text-on-surface-variant/50 focus:outline-none focus:border-secondary"
                    placeholder="Write a comment..." data-post-id="<%= post.id %>">
                  <button class="comment-submit-btn px-3 py-2 rounded-full bg-secondary text-white text-[10px] font-bold" data-post-id="<%= post.id %>">
                    <span class="material-symbols-outlined text-sm">send</span>
                  </button>
                </div>
              </div>
              <% } %>
            </div>
          </div>
          <% }) %>
        </div>
      </div>

      <!-- Sidebar -->
      <% if (typeof user !== 'undefined' && user) { %>
      <div class="w-full lg:w-72 shrink-0 flex flex-col gap-4">
        <!-- Friends link -->
        <a href="/wall/friends" class="tactile-card rounded-2xl p-4 flex items-center gap-3 border border-surface-container-highest hover:border-secondary transition-colors group">
          <div class="w-10 h-10 rounded-xl bg-secondary-container text-on-secondary-container flex items-center justify-center group-hover:scale-110 transition-transform">
            <span class="material-symbols-outlined">group</span>
          </div>
          <div class="flex-1">
            <span class="font-label-md font-bold text-on-surface text-sm block">My Friends</span>
            <span class="text-[11px] text-on-surface-variant">View friends & requests</span>
          </div>
          <% if (pendingCount > 0) { %>
          <span class="w-6 h-6 rounded-full bg-secondary text-white text-[10px] font-bold flex items-center justify-center"><%= pendingCount %></span>
          <% } else { %>
          <span class="material-symbols-outlined text-on-surface-variant text-sm">chevron_right</span>
          <% } %>
        </a>

        <!-- People You May Know -->
        <% if (people.length > 0) { %>
        <div class="tactile-card rounded-2xl p-4 border border-surface-container-highest">
          <h3 class="font-label-md font-bold text-on-surface text-xs uppercase tracking-wider mb-3 flex items-center gap-1.5">
            <span class="material-symbols-outlined text-secondary text-sm">person_search</span> People You May Know
          </h3>
          <div class="flex flex-col gap-3">
            <% people.forEach(function(p) { %>
            <div class="flex items-center gap-2">
              <div class="w-8 h-8 rounded-full bg-secondary-container text-on-secondary-container flex items-center justify-center text-sm font-bold shrink-0"><%= p.avatar %></div>
              <span class="flex-1 text-xs font-bold text-on-surface truncate"><%= p.name %></span>
              <button class="add-friend-side-btn px-2 py-1 rounded-full bg-secondary text-white text-[10px] font-bold hover:opacity-90 active:scale-95 transition-all" data-user-id="<%= p.id %>">
                <span class="material-symbols-outlined text-[12px]">person_add</span>
              </button>
            </div>
            <% }) %>
          </div>
        </div>
        <% } %>
      </div>
      <% } %>
    </div>
  </div>
</section>

<!-- Share Score Modal -->
<div id="scoreModal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/40 backdrop-blur-sm p-4">
  <div class="tactile-card rounded-3xl p-6 w-full max-w-sm shadow-2xl border border-surface-container-highest bg-surface-container-lowest">
    <h3 class="font-headline-sm text-headline-sm text-on-surface mb-4 flex items-center gap-2">
      <span class="material-symbols-outlined text-secondary">emoji_events</span> Share Your Score
    </h3>
    <form id="scoreForm" class="flex flex-col gap-3">
      <select name="game" id="scoreGame" class="w-full px-3 py-2.5 rounded-xl bg-surface-container-low border border-surface-container-highest text-on-surface text-sm font-body-sm focus:outline-none focus:border-secondary">
        <option value="Math Quest">Math Quest</option>
        <option value="Memory Match">Memory Match</option>
        <option value="Word Scramble">Word Scramble</option>
        <option value="Counting Stars">Counting Stars</option>
        <option value="Color Match">Color Match</option>
        <option value="Pattern Puzzle">Pattern Puzzle</option>
      </select>
      <input type="number" name="score" id="scoreValue" placeholder="Your score" required
        class="w-full px-3 py-2.5 rounded-xl bg-surface-container-low border border-surface-container-highest text-on-surface text-sm font-body-sm focus:outline-none focus:border-secondary">
      <div class="flex gap-2 justify-end">
        <button type="button" id="cancelScore" class="px-4 py-2 rounded-full bg-surface-container text-on-surface-variant text-xs font-label-sm font-bold">Cancel</button>
        <button type="submit" class="px-5 py-2 rounded-full bg-secondary text-white text-xs font-label-sm font-bold shadow-sm">Share Score</button>
      </div>
    </form>
  </div>
</div>

<%- include('partials/footer') %>
<script>
(function() {
  function friendAction(url, userId) {
    fetch(url, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ userId: userId })
    }).then(function(r) { return r.json(); }).then(function(data) {
      if (data.success) window.location.reload();
    }).catch(function() {});
  }

  document.querySelectorAll('.add-friend-post-btn, .add-friend-side-btn').forEach(function(btn) {
    btn.addEventListener('click', function() { friendAction('/wall/friend/add', btn.getAttribute('data-user-id')); });
  });
  document.querySelectorAll('.accept-post-btn').forEach(function(btn) {
    btn.addEventListener('click', function() { friendAction('/wall/friend/accept', btn.getAttribute('data-user-id')); });
  });

  // React
  document.querySelectorAll('.react-btn').forEach(function(btn) {
    btn.addEventListener('click', async function() {
      var postId = btn.getAttribute('data-post-id');
      try {
        var res = await fetch('/wall/react', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ postId: postId, emoji: '\u2764\uFE0F' }) });
        var data = await res.json();
        if (data.success) {
          btn.querySelector('.react-count').textContent = data.count;
          var icon = btn.querySelector('.material-symbols-outlined');
          if (data.action === 'added') { btn.classList.add('text-secondary'); btn.classList.remove('text-on-surface-variant'); icon.style.fontVariationSettings = "'FILL' 1"; }
          else { btn.classList.remove('text-secondary'); btn.classList.add('text-on-surface-variant'); icon.style.fontVariationSettings = "'FILL' 0"; }
        }
      } catch (e) {}
    });
  });

  document.querySelectorAll('.comment-toggle-btn').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var section = document.querySelector('.comments-section[data-post-id="' + btn.getAttribute('data-post-id') + '"]');
      if (section) section.classList.toggle('hidden');
    });
  });

  document.querySelectorAll('.comment-submit-btn').forEach(function(btn) {
    btn.addEventListener('click', async function() {
      var postId = btn.getAttribute('data-post-id');
      var input = document.querySelector('.comment-input[data-post-id="' + postId + '"]');
      if (!input || !input.value.trim()) return;
      try {
        var res = await fetch('/wall/comment', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ postId: postId, text: input.value.trim() }) });
        var data = await res.json();
        if (data.success) {
          var c = data.comment;
          var list = document.querySelector('.comments-list[data-post-id="' + postId + '"]');
          list.innerHTML += '<div class="flex items-start gap-2"><div class="w-6 h-6 rounded-full bg-secondary-container text-on-secondary-container flex items-center justify-center text-[10px] font-bold shrink-0">' + c.userAvatar + '</div><div class="flex-1 bg-surface-container-lowest rounded-xl px-3 py-2"><span class="text-[11px] font-bold text-on-surface">' + c.userName + '</span><p class="text-[12px] text-on-surface-variant">' + c.text + '</p></div></div>';
          input.value = '';
          var countEl = btn.closest('.tactile-card').querySelector('.comment-count');
          if (countEl) countEl.textContent = data.count;
        }
      } catch (e) {}
    });
  });

  document.querySelectorAll('.comment-input').forEach(function(input) {
    input.addEventListener('keydown', function(e) { if (e.key === 'Enter') { var btn = document.querySelector('.comment-submit-btn[data-post-id="' + input.getAttribute('data-post-id') + '"]'); if (btn) btn.click(); } });
  });

  var imageInput = document.getElementById('postImageInput');
  var imageDataInput = document.getElementById('postImageData');
  var preview = document.getElementById('postImagePreview');
  var previewImg = document.getElementById('postPreviewImg');
  var removeBtn = document.getElementById('removeImage');

  if (imageInput) { imageInput.addEventListener('change', function() { var file = imageInput.files[0]; if (!file) return; var reader = new FileReader(); reader.onload = function(e) { imageDataInput.value = e.target.result; previewImg.src = e.target.result; preview.classList.remove('hidden'); }; reader.readAsDataURL(file); }); }
  if (removeBtn) { removeBtn.addEventListener('click', function() { imageDataInput.value = ''; preview.classList.add('hidden'); if (imageInput) imageInput.value = ''; }); }

  var scoreBtn = document.getElementById('shareScoreBtn');
  var scoreModal = document.getElementById('scoreModal');
  var cancelScore = document.getElementById('cancelScore');
  var scoreForm = document.getElementById('scoreForm');

  if (scoreBtn && scoreModal) {
    scoreBtn.addEventListener('click', function() { scoreModal.classList.remove('hidden'); });
    cancelScore.addEventListener('click', function() { scoreModal.classList.add('hidden'); });
    scoreModal.addEventListener('click', function(e) { if (e.target === scoreModal) scoreModal.classList.add('hidden'); });

    <% if (typeof shareScore !== 'undefined' && shareScore) { %>
    var scoreVal = document.getElementById('scoreValue');
    var gameSel = document.getElementById('scoreGame');
    if (scoreVal) scoreVal.value = '<%= shareScore %>';
    if (gameSel && '<%= shareGame %>') { for (var i = 0; i < gameSel.options.length; i++) { if (gameSel.options[i].value === '<%= shareGame %>') { gameSel.selectedIndex = i; break; } } }
    scoreModal.classList.remove('hidden');
    <% } %>

    scoreForm.addEventListener('submit', async function(e) {
      e.preventDefault();
      var game = document.getElementById('scoreGame').value;
      var score = document.getElementById('scoreValue').value;
      try {
        var res = await fetch('/wall/score', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ game: game, score: Number(score) }) });
        var data = await res.json();
        if (data.success) { scoreModal.classList.add('hidden'); window.location.reload(); }
      } catch (e) {}
    });
  }
})();
</script>
</body></html>
