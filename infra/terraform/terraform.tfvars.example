# Terraform variables for the WonderKids platform
# Copy to terraform.tfvars and fill in your values.

aws_region     = "ap-southeast-2"
environment    = "production"
app_name       = "wonderkids"
ubuntu_ami_id  = "ami-06259b63260eddc13"

vpc_cidr            = "10.0.0.0/16"
public_subnet_cidrs = ["10.0.1.0/24", "10.0.2.0/24"]

# EC2 key pair derived from /Users/lekym/Downloads/Project.pem
ssh_key_name              = "Project"
ssh_public_key            = "ssh-rsa "
ssh_private_key_path      = "/Users/lekym/Downloads/Project.pem"
admin_allowed_cidr_blocks = ["0.0.0.0/0"]

monitoring_allowed_cidr_blocks = ["0.0.0.0/0"]
monitoring_instance_type       = "c7i-flex.large"
monitoring_root_volume_size    = 8

prometheus_enabled = true
prometheus_version = "2.51.2"

grafana_enabled        = true
grafana_admin_password = ""

alertmanager_enabled = false
alertmanager_version = "0.27.0"

microservice_names       = ["backend", "frontend"]
ecr_image_tag_mutability = "MUTABLE"
ecr_scan_on_push         = true
ecr_force_delete         = true

eks_enabled                    = true
eks_version                    = "1.36"
eks_public_access_cidr_blocks  = ["0.0.0.0/0"]
eks_node_instance_types        = ["c7i-flex.large"]
eks_node_capacity_type         = "ON_DEMAND"
eks_node_disk_size             = 20
eks_node_min_size              = 1
eks_node_desired_size          = 2
eks_node_max_size              = 3
# IAM user used to run terraform / kubectl against the cluster
eks_admin_role_arn             = "arn:aws:iam::218619602282:user/malik"

jenkins_instance_type        = "c7i.large"
jenkins_root_volume_size     = 50
sonarqube_version            = "10.6.0.92116"