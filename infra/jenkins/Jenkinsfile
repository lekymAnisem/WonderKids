pipeline {
    agent any

    options {
        skipDefaultCheckout(true)
        disableConcurrentBuilds()
        timestamps()
    }

    tools {
        jdk 'jdk21'
        nodejs 'node20'
    }

    environment {
        AWS_REGION     = 'ap-southeast-2'
        APP_NAME       = 'WonderKids'
        APP_NAME_LOWER = APP_NAME.toLowerCase()
        ENVIRONMENT    = 'production'

        ECR_BACKEND   = "${APP_NAME_LOWER}-${ENVIRONMENT}-backend"
        ECR_FRONTEND  = "${APP_NAME_LOWER}-${ENVIRONMENT}-frontend"

        IMAGE_TAG    = "${BUILD_NUMBER}"
        VALUES_FILE  = 'infra/helm/wonderkids/values.yaml'

        SONAR_SERVER = 'Sonarserver'
        SONAR_TOOL   = 'SonarQube'
    }

    stages {
        stage('Clean Workspace') {
            steps {
                deleteDir()
            }
        }

        stage('Checkout Code') {
            steps {
                git branch: 'main',
                    credentialsId: 'github-token',
                    url: 'https://github.com/lekymAnisem/WonderKids.git'
            }
        }

        stage('Verify Project Structure') {
            steps {
                sh '''
                    set -e
                    echo "Workspace: $(pwd)"
                    ls -la

                    for tier in backend frontend; do
                        test -d "$tier" || { echo "ERROR: $tier not found"; exit 1; }
                        test -f "$tier/Dockerfile" || { echo "ERROR: $tier/Dockerfile not found"; exit 1; }
                    done

                    test -f "$VALUES_FILE" || { echo "ERROR: $VALUES_FILE not found"; exit 1; }
                '''
            }
        }

        stage('Verify Required Tools') {
            steps {
                sh '''
                    set -e
                    echo "Node: $(node --version)"
                    echo "NPM: $(npm --version)"
                    java -version
                    docker --version
                    aws --version
                    trivy --version || true
                    yq --version || true
                    kubectl version --client || true
                    helm version --short || true
                '''
            }
        }

        stage('Initialize AWS') {
            steps {
                withAWS(credentials: 'aws-creds', region: 'ap-southeast-2') {
                    script {
                        env.AWS_ACCOUNT_ID = sh(
                            script: 'aws sts get-caller-identity --query Account --output text',
                            returnStdout: true
                        ).trim()
                        if (!env.AWS_ACCOUNT_ID) error('Unable to retrieve AWS account ID')
                        echo "AWS account ID: ${env.AWS_ACCOUNT_ID}, region: ${env.AWS_REGION}"
                    }
                }
            }
        }

        stage('Ensure ECR Repositories') {
            steps {
                withAWS(credentials: 'aws-creds', region: 'ap-southeast-2') {
                    sh '''
                        set -e
                        for REPO in "$ECR_BACKEND" "$ECR_FRONTEND"; do
                            aws ecr describe-repositories --repository-names "$REPO" --region "$AWS_REGION" >/dev/null 2>&1 || \
                            aws ecr create-repository --repository-name "$REPO" --image-scanning-configuration scanOnPush=true --region "$AWS_REGION"
                        done
                    '''
                }
            }
        }

        stage('Install Dependencies') {
            parallel {
                stage('Backend Dependencies') {
                    steps {
                        dir('backend') {
                            sh '''
                                set -e
                                if [ -f package-lock.json ]; then npm ci; else npm install; fi
                            '''
                        }
                    }
                }

                stage('Frontend Dependencies') {
                    steps {
                        dir('frontend') {
                            sh '''
                                set -e
                                if [ -f package-lock.json ]; then npm ci; else npm install; fi
                            '''
                        }
                    }
                }
            }
        }

        stage('TypeScript Check') {
            steps {
                dir('backend') {
                    sh '''
                        set -e
                        if [ -f tsconfig.json ]; then
                            npm run typecheck
                        else
                            echo "No tsconfig.json. Skipping."
                        fi
                    '''
                }
            }
        }

        stage('Run Tests') {
            parallel {
                stage('Backend Tests') {
                    steps {
                        dir('backend') {
                            withAWS(credentials: 'aws-creds', region: 'ap-southeast-2') {
                                sh '''
                                    set +x

                                    if ! npm run 2>/dev/null | grep -q "test"; then
                                        echo "No test script configured"
                                        exit 0
                                    fi

                                    if ! SECRET_JSON=$(aws secretsmanager get-secret-value \
                                            --secret-id wonderkids-secrets \
                                            --query SecretString --output text); then
                                        echo "ERROR: cannot read secret 'wonderkids-secrets' from AWS Secrets Manager"
                                        exit 1
                                    fi

                                    # Parse with node instead of grep. The previous
                                    # grep -o '"KEY"[^,]*' stopped at the first comma in
                                    # the value and returned an empty string with no
                                    # error, which surfaced as a Prisma P1013. node is
                                    # already required by the npm test step below, so
                                    # this adds no new dependency to the agent.
                                    #
                                    # wonderkids-secrets has been hand-entered in more
                                    # than one shape: JSON, and dotenv wrapped in stray
                                    # braces. Accept both, so a formatting slip in the
                                    # console cannot fail the build. Defined as a shell
                                    # variable and passed through "$PARSER_JS" so the
                                    # JavaScript never needs shell quoting; the value
                                    # is expanded literally, so quotes and backslashes
                                    # inside it are safe.
                                    PARSER_JS='
                                    const parse = (raw) => {
                                        const text = raw.trim();
                                        if (!text) return null;

                                        try {
                                            const parsed = JSON.parse(text);
                                            if (parsed && typeof parsed === "object" && !Array.isArray(parsed)) {
                                                return { data: parsed, format: "json" };
                                            }
                                        } catch (err) {
                                            // not JSON, fall through to dotenv
                                        }

                                        const NL = String.fromCharCode(10);
                                        const HASH = String.fromCharCode(35);
                                        const DQUOTE = String.fromCharCode(34);
                                        const SQUOTE = String.fromCharCode(39);
                                        const isQuote = (c) => c === DQUOTE || c === SQUOTE;

                                        let body = text;
                                        if (body.charAt(0) === "{") body = body.slice(1);
                                        if (body.charAt(body.length - 1) === "}") {
                                            body = body.slice(0, body.length - 1);
                                        }

                                        const data = {};
                                        let found = false;

                                        for (const line of body.split(NL)) {
                                            const trimmed = line.trim();
                                            if (!trimmed || trimmed.charAt(0) === HASH) continue;

                                            const eq = trimmed.indexOf("=");
                                            if (eq < 1) continue;

                                            let key = trimmed.slice(0, eq).trim();
                                            if (key.length > 1
                                                    && isQuote(key.charAt(0))
                                                    && isQuote(key.charAt(key.length - 1))) {
                                                key = key.slice(1, key.length - 1).trim();
                                            }
                                            if (!key) continue;

                                            data[key] = trimmed.slice(eq + 1).trim();
                                            found = true;
                                        }

                                        return found ? { data, format: "dotenv" } : null;
                                    };

                                    let raw = "";
                                    process.stdin
                                        .on("data", (chunk) => (raw += chunk))
                                        .on("end", () => {
                                            const result = parse(raw);
                                            const mode = process.env.WK_SECRET_MODE;

                                            if (mode === "format") {
                                                process.stdout.write(result ? result.format : "unrecognized");
                                                return;
                                            }
                                            if (mode === "keys") {
                                                process.stdout.write(result ? Object.keys(result.data).join(", ") : "");
                                                return;
                                            }
                                            if (!result) process.exit(1);
                                            process.stdout.write(String(result.data[process.env.WK_SECRET_KEY] ?? ""));
                                        });
                                    '

                                    read_secret() {
                                        printf '%s' "$SECRET_JSON" | WK_SECRET_MODE=value WK_SECRET_KEY="$1" node -e "$PARSER_JS"
                                    }

                                    # Key names only, never values, for diagnostics.
                                    secret_keys() {
                                        printf '%s' "$SECRET_JSON" | WK_SECRET_MODE=keys node -e "$PARSER_JS"
                                    }

                                    secret_format() {
                                        printf '%s' "$SECRET_JSON" | WK_SECRET_MODE=format node -e "$PARSER_JS"
                                    }

                                    # Trim whitespace and quotes a hand-edited secret
                                    # often carries; Prisma rejects the whole URL.
                                    normalize_url() {
                                        printf '%s' "$1" \
                                            | tr -d '\r' \
                                            | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' \
                                                  -e 's/^"//' -e 's/"$//'
                                    }

                                    # Describe a bad URL without ever printing the
                                    # password. Only the scheme and the host (the text
                                    # after the last @) are safe to show, so anything
                                    # else is reported as a placeholder.
                                    describe_url() {
                                        case "$1" in
                                            *@*) ;;
                                            *)
                                                printf '<no host> (length %s)' "${#1}"
                                                return
                                                ;;
                                        esac

                                        SCHEME=$(printf '%s' "$1" \
                                            | sed -nE 's#^([a-zA-Z0-9+.-]+)://.*#\1#p')
                                        [ -n "$SCHEME" ] || SCHEME="none"

                                        HOST=$(printf '%s' "$1" \
                                            | sed -E 's#^[a-zA-Z0-9+.-]+://##; s#^.*@##; s#/.*##')

                                        printf 'scheme=%s host=%s' "$SCHEME" "$HOST"
                                    }

                                    validate_url() {
                                        case "$2" in
                                            postgresql://*|postgres://*) ;;
                                            *)
                                                echo "ERROR: $1 in 'wonderkids-secrets' is not a Postgres URL."
                                                echo "       Expected: postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require"
                                                echo "       Got:      $(describe_url "$2")"
                                                return 1
                                                ;;
                                        esac

                                        case "$2" in
                                            *@*/*) ;;
                                            *)
                                                echo "ERROR: $1 in 'wonderkids-secrets' has no host and database."
                                                echo "       Got: $(describe_url "$2")"
                                                return 1
                                                ;;
                                        esac
                                    }

                                    DATABASE_URL=$(normalize_url "$(read_secret DATABASE_URL)")
                                    DIRECT_URL=$(normalize_url "$(read_secret DIRECT_URL)")

                                    test -n "$DIRECT_URL" || DIRECT_URL="$DATABASE_URL"
                                    test -n "$DATABASE_URL" || DATABASE_URL="$DIRECT_URL"

                                    if [ -z "$DIRECT_URL" ]; then
                                        echo "ERROR: 'wonderkids-secrets' has no usable DATABASE_URL or DIRECT_URL."
                                        echo "       Format: $(secret_format)   (length ${#SECRET_JSON})"
                                        echo "       Keys:   $(secret_keys)"
                                        echo "       The secret must hold either a JSON object or KEY=value lines."
                                        exit 1
                                    fi

                                    validate_url DIRECT_URL "$DIRECT_URL" || exit 1
                                    validate_url DATABASE_URL "$DATABASE_URL" || exit 1

                                    echo "Using test database at $(describe_url "$DIRECT_URL")"

                                    export DATABASE_URL DIRECT_URL
                                    set -x
                                    npm test
                                '''
                            }
                        }
                    }
                }

                stage('Frontend Tests') {
                    steps {
                        dir('frontend') {
                            sh '''
                                set -e
                                if npm run 2>/dev/null | grep -q "test"; then
                                    npm test
                                else
                                    echo "No frontend test script configured"
                                fi
                            '''
                        }
                    }
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                script {
                    def scannerHome = tool(
                        name: env.SONAR_TOOL,
                        type: 'hudson.plugins.sonar.SonarRunnerInstallation'
                    )
                    withSonarQubeEnv(env.SONAR_SERVER) {
                        sh """
                            set -e
                            echo "SonarScanner: ${scannerHome}"

                            "${scannerHome}/bin/sonar-scanner" \
                                -Dsonar.projectKey=wonderkids \
                                -Dsonar.projectName="WonderKids" \
                                -Dsonar.sources=backend/src,frontend \
                                -Dsonar.sourceEncoding=UTF-8 \
                                -Dsonar.exclusions="**/node_modules/**,**/dist/**,**/coverage/**,**/uploads/**"
                        """
                    }
                }
            }
        }

        stage('Quality Gate') {
            steps {
                script {
                    try {
                        timeout(time: 10, unit: 'MINUTES') {
                            waitForQualityGate abortPipeline: false
                        }
                    } catch (err) {
                        echo "SonarQube quality gate check failed: ${err.message}"
                        echo "Continuing pipeline (abortPipeline: false)."
                    }
                }
            }
        }

        stage('Trivy File System Scan') {
            steps {
                sh '''
                    set +e
                    trivy fs --format table --severity HIGH,CRITICAL --output trivy-fs.txt .
                    echo "Trivy exit code: $?"
                    exit 0
                '''
            }

            post {
                always {
                    archiveArtifacts(
                        artifacts: 'trivy-fs.txt',
                        allowEmptyArchive: true
                    )
                }
            }
        }

        stage('Trivy Config Scan (Dockerfile/IaC)') {
            steps {
                sh '''
                    set +e
                    # Scan entire workspace directory recursively
                    trivy config --format table --severity HIGH,CRITICAL \
                        --output trivy-config.txt .
                    echo "Trivy config exit code: $?"
                    exit 0
                '''
            }

            post {
                always {
                    archiveArtifacts(
                        artifacts: 'trivy-config.txt',
                        allowEmptyArchive: true
                    )
                }
            }
        }

        stage('Free Up Disk Space') {
            steps {
                sh '''
                    docker system prune -a -f --volumes || true
                    docker builder prune -f || true
                    df -h /
                '''
            }
        }

        stage('Login to ECR') {
            steps {
                withAWS(credentials: 'aws-creds', region: 'ap-southeast-2') {
                    sh '''
                        set -e
                        ECR_REGISTRY="${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com"
                        aws ecr get-login-password --region "$AWS_REGION" |
                        docker login --username AWS --password-stdin "$ECR_REGISTRY"
                    '''
                }
            }
        }

        stage('Build Backend') {
            steps {
                buildServiceImage('backend', "${ECR_BACKEND}")
            }
        }

        stage('Build Frontend') {
            steps {
                buildServiceImage('frontend', "${ECR_FRONTEND}")
            }
        }

        stage('Trivy Scan Backend') {
            steps { scanTrivy("${ECR_BACKEND}", 'trivy-backend.txt') }
            post { always { archiveArtifacts(artifacts: 'trivy-backend.txt', allowEmptyArchive: true) } }
        }

        stage('Trivy Scan Frontend') {
            steps { scanTrivy("${ECR_FRONTEND}", 'trivy-frontend.txt') }
            post { always { archiveArtifacts(artifacts: 'trivy-frontend.txt', allowEmptyArchive: true) } }
        }

        stage('Push Backend') {
            steps { pushServiceImage("${ECR_BACKEND}") }
        }

        stage('Push Frontend') {
            steps { pushServiceImage("${ECR_FRONTEND}") }
        }

        stage('Update Helm Image Tags') {
            steps {
                withCredentials([
                    string(
                        credentialsId: 'github-token',
                        variable: 'GIT_TOKEN'
                    )
                ]) {
                    sh '''
                        set -e

                        test -f "$VALUES_FILE" || {
                            echo "ERROR: $VALUES_FILE not found"
                            exit 1
                        }

                        echo "Updating Helm image tags to ${IMAGE_TAG} in ${VALUES_FILE}"

                        # Only mikefarah/yq v4 understands 'eval -i'. Other yq builds
                        # (e.g. the python/jq wrapper) must fall through to awk.
                        YQ_BIN=""
                        if command -v yq >/dev/null 2>&1 && yq --version 2>/dev/null | grep -q "mikefarah"; then
                            YQ_BIN="yq eval"
                        fi

                        if [ -n "$YQ_BIN" ]; then
                            echo "Using mikefarah/yq: $(yq --version)"
                            for SERVICE in backend frontend; do
                                $YQ_BIN -i ".services.${SERVICE}.image.tag = \"${IMAGE_TAG}\"" "$VALUES_FILE"
                            done

                            echo "--- Updated Helm image tags ---"
                            for SERVICE in backend frontend; do
                                echo "${SERVICE}: $($YQ_BIN ".services.${SERVICE}.image.tag" "$VALUES_FILE")"
                            done
                        else
                            echo "WARNING: mikefarah/yq v4 not available on this agent; using awk fallback"

                            # Only safe while values.yaml holds exactly two image tags
                            # at the services.<name>.image.tag indent. Validate BEFORE
                            # rewriting so an unrelated tag: key can never be clobbered.
                            TOTAL_TAGS=$(grep -cE '^[[:space:]]*tag:' "$VALUES_FILE" || true)
                            IMAGE_TAGS=$(grep -cE '^      tag: ' "$VALUES_FILE" || true)
                            if [ "${TOTAL_TAGS}" -ne 2 ] || [ "${IMAGE_TAGS}" -ne 2 ]; then
                                echo "ERROR: expected exactly 2 image tags at 6-space indent,"
                                echo "       found ${IMAGE_TAGS}/${TOTAL_TAGS} in ${VALUES_FILE}."
                                echo "       Install mikefarah/yq v4 on this agent, or update the awk fallback."
                                exit 1
                            fi

                            SQ="'"
                            awk -v tag="${IMAGE_TAG}" -v q="${SQ}" '
                                /^      tag:/ {
                                    print "      tag: " q tag q
                                    next
                                }
                                { print }
                            ' "$VALUES_FILE" > "${VALUES_FILE}.tmp"
                            mv "${VALUES_FILE}.tmp" "$VALUES_FILE"

                            UPDATED=$(grep -cE "^      tag: '${IMAGE_TAG}'\$" "$VALUES_FILE" || true)
                            if [ "${UPDATED}" -ne 2 ]; then
                                echo "ERROR: expected 2 image tags set to ${IMAGE_TAG}, found ${UPDATED}"
                                exit 1
                            fi
                        fi

                        grep -nE '^[[:space:]]*tag:' "$VALUES_FILE" || true

                        # Configure Git identity
                        git config user.name "Jenkins CI"
                        git config user.email "jenkins@wonderkids.local"

                        git add "$VALUES_FILE"

                        if git diff --cached --quiet; then
                            echo "No Helm values changes detected."
                            exit 0
                        fi

                        git commit -m "chore(gitops): deploy build ${BUILD_NUMBER} [skip ci]"

                        # Rebase onto any commits landed on main since checkout so the
                        # push is never rejected as non-fast-forward.
                        git fetch origin
                        git rebase origin/main || {
                            echo "ERROR: rebase onto origin/main failed - resolve manually"
                            exit 1
                        }

                        # Push using the Personal Access Token. 'github-token' is a
                        # Secret text credential, so there is no username to pair with
                        # it - x-access-token is the username GitHub expects for PATs.
                        # GIT_TERMINAL_PROMPT=0 stops git from hanging on a prompt if
                        # the token is ever rejected.
                        GIT_TERMINAL_PROMPT=0 git push \
                            "https://x-access-token:${GIT_TOKEN}@github.com/lekymAnisem/WonderKids.git" \
                            HEAD:main
                    '''
                }
            }
        }
    }

    post {
        success {
            echo "CI succeeded: images pushed and Helm values updated for Argo CD build ${BUILD_NUMBER}"
        }

        failure {
            echo "Pipeline failed for build ${BUILD_NUMBER}"
        }

        always {
            archiveArtifacts(
                artifacts: 'infra/helm/wonderkids/values.yaml',
                allowEmptyArchive: true
            )

            withAWS(credentials: 'aws-creds', region: 'ap-southeast-2') {
                sh '''
                    docker logout "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com" 2>/dev/null || true
                '''
            }
        }
    }
}

// ── Shared helper methods ────────────────────────────────────────────

def buildServiceImage(String contextDir, String ecrRepo) {
    sh """
        set -e
        IMAGE="\${AWS_ACCOUNT_ID}.dkr.ecr.\${AWS_REGION}.amazonaws.com/${ecrRepo}"
        docker build --tag "\${IMAGE}:\${IMAGE_TAG}" --tag "\${IMAGE}:latest" ./${contextDir}
    """
}

def scanTrivy(String ecrRepo, String outputFile) {
    sh """
        set +e
        IMAGE="\${AWS_ACCOUNT_ID}.dkr.ecr.\${AWS_REGION}.amazonaws.com/${ecrRepo}:\${IMAGE_TAG}"
        trivy image --format table --severity HIGH,CRITICAL --output ${outputFile} "\$IMAGE"
        exit 0
    """
}

def pushServiceImage(String ecrRepo) {
    sh """
        set -e
        IMAGE="\${AWS_ACCOUNT_ID}.dkr.ecr.\${AWS_REGION}.amazonaws.com/${ecrRepo}"
        docker push "\${IMAGE}:\${IMAGE_TAG}"
        docker push "\${IMAGE}:latest"
    """
}